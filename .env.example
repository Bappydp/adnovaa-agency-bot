# Copy this file to ".env" and fill in your real values.
# NEVER commit a real .env file or share your token with anyone.

# BotFather token for this bot (from @BotFather -> /newbot)
BOT_TOKEN=

# Your Telegram user ID(s), comma-separated if more than one.
# Get yours from @userinfobot (send /start, it replies with your ID).
# Pre-filled with the owner's ID — admin commands work even if you
# leave this line as it is.
ADMIN_IDS=6824922316

# Channel username WITH @ — default is the agency channel.
# (Override here only if the channel ever changes.)
CHANNEL_ID=@facebookads_adnovaa

# Bot username WITHOUT @ (for referral links) — override only if needed.
BOT_USERNAME=adnovaaagencybot

# Public group chat ID (numbers, starts with -100), optional.
# Used for giveaway announcements. Get it from @RawDataBot or similar.
GROUP_ID=

# Port for the health endpoint (Render sets PORT itself; leave as is)
PORT=10000
